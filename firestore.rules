
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /SareeCollection/{sareeId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isWholesaler();
      allow delete: if isAdmin() || (isWholesaler() && request.auth.uid == resource.data.ownerId);
      allow update: if isAdmin() || 
                    (isWholesaler() && request.auth.uid == resource.data.ownerId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']));
    }

    match /restockRequests/{requestId} {
      allow create: if isSignedIn();
      // Separating get and list for clarity. List requires query filters to match rules.
      allow list: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.userId);
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /orders/{orderId} {
      // Allowing specific read/write permissions for orders
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.user_id || isOrderOwner(orderId));
      allow write: if true; // Temporary broad write for checkout process
    }

    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /countries/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /states/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sareeVarieties/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isWholesaler() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'wholesaler';
    }
    
    function isOrderOwner(orderId) {
        let orderData = get(/databases/$(database)/documents/orders/$(orderId)).data;
        // Simple ownership check based on UID
        return request.auth.uid == orderData.user_id;
    }
  }
}
