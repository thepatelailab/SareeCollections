
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Saree Collection: Public read, restricted write
    match /SareeCollection/{sareeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 2. Waitlist (Restock Requests): Completely open to prioritize partner visibility
    match /restockRequests/{requestId} {
      allow read, write: if true;
    }
    
    // Explicitly allow list operations at the collection level
    match /restockRequests {
      allow list: if true;
    }

    // 3. Orders: Accessible to signed-in users
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if true; // Open for checkout process
    }

    // 4. Partner Applications
    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 5. Metadata Collections
    match /countries/{id} { allow read: if true; allow write: if isAdmin(); }
    match /states/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sareeVarieties/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // 6. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }
  }
}
