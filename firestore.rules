rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /SareeCollection/{sareeId} {
      allow get, list: if true;
      allow create, delete: if isAdmin() || isWholesaler();
      allow update: if isAdmin() || 
                    (isWholesaler() && request.auth.uid == resource.data.ownerId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']));
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (isAdmin() || isWholesaler() || (resource != null && isOwner(resource.data.user_id)));
      // Allow users to update their own orders (needed for syncing shipping details post-payment)
      allow update: if isSignedIn() && (isAdmin() || isWholesaler() || (resource != null && isOwner(resource.data.user_id)));
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /countries/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /states/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sareeVarieties/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Explicitly allow users to read and write their own profile data
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
        // Short-circuit on admin email to avoid dependency on profile doc existence
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
        );
    }

    function isWholesaler() {
        return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'wholesaler';
    }
  }
}