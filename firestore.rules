
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /SareeCollection/{sareeId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isWholesaler();
      allow delete: if isAdmin() || (isWholesaler() && request.auth.uid == resource.data.ownerId);
      allow update: if isAdmin() || 
                    (isWholesaler() && request.auth.uid == resource.data.ownerId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']));
    }

    match /restockRequests/{requestId} {
      // Removing restrictions to ensure partners can always view their waitlist
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /orders/{orderId} {
      // Streamlined order rules
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.user_id);
      allow write: if true; // Temporary broad write for checkout process
    }

    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /countries/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /states/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sareeVarieties/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isWholesaler() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'wholesaler';
    }
  }
}
