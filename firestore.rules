rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /SareeCollection/{sareeId} {
      allow get, list: if true;
      allow create, delete: if isAdmin() || isWholesaler();
      allow update: if isAdmin() || 
                    (isWholesaler() && request.auth.uid == resource.data.ownerId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']));
    }

    match /orders/{orderId} {
      // Rule 1: Admin/Wholesaler can list/get everything
      allow list, get: if isSignedIn() && (isAdmin() || isWholesaler());
      
      // Rule 2: Normal customers can ONLY list their own orders
      // Note: This requires the frontend query to have a matching .where('user_id', '==', auth.uid)
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isWholesaler() || (resource != null && resource.data.user_id == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /countries/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /states/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sareeVarieties/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
        // Instant check for super admin email to bypass document lookup latency
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isWholesaler() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'wholesaler';
    }
  }
}