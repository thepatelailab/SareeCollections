rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /SareeCollection/{sareeId} {
      allow get, list: if true;
      allow create, delete: if isAdmin() || isWholesaler();
      allow update: if isAdmin() || 
                    (isWholesaler() && request.auth.uid == resource.data.ownerId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']));
    }

    match /orders/{orderId} {
      // Allow list if admin/wholesaler OR if query is filtered by user_id
      allow list: if isSignedIn() && (
        isAdmin() || 
        isWholesaler() || 
        (request.query.limit <= 100 && request.auth.uid == resource.data.user_id)
      );
      allow get: if isSignedIn() && (isAdmin() || isWholesaler() || isOwner(resource.data.user_id));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isWholesaler() || isOwner(resource.data.user_id));
      allow delete: if isAdmin();
    }

    match /wholesalerRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /countries/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /states/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sareeVarieties/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
        // Safe check for super admin email or admin role
        return isSignedIn() && (
          (request.auth.token.email == 'bp.brpl@gmail.com') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isWholesaler() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'wholesaler';
    }
  }
}