rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // 1. Allow users to manage their own profile images (Top priority)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Allow authenticated users to write to 'SareeCollection'
    match /SareeCollection/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Allow authenticated users to write to 'settings'
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Global read access for all other paths
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}