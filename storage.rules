rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read;
    }

    // Allow users to manage their own profile images
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to write to the 'SareeCollection' directory
    match /SareeCollection/{productId}/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Allow authenticated users to write to the 'settings' directory
    match /settings/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}