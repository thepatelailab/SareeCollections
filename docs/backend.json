
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A heritage product in the marketplace (Saree, Crochet, or Lehenga).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "stock": { "type": "number" },
        "sareeImg": { "type": "string", "description": "Original product image URL" },
        "sareeImgHint": { "type": "string" },
        "modelImg": { "type": "string", "description": "AI generated lifestyle/model image URL" },
        "variety": { "type": "string" },
        "category": { "type": "string", "enum": ["saree", "crochet", "lehenga"] },
        "likes": { "type": "number" },
        "shares": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "price", "description", "category"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about a user or partner boutique.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["customer", "admin", "wholesaler"] },
        "email": { "type": "string", "format": "email" },
        "businessName": { "type": "string" },
        "bannerUrl": { "type": "string" }
      },
      "required": ["role"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/SareeCollection/{productId}": {
      "schema": "Product",
      "description": "Unified collection of all heritage products across all categories."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and boutique information."
    },
    "/orders/{orderId}": {
      "schema": { "type": "object" },
      "description": "Platform orders and transactions."
    }
  }
}
