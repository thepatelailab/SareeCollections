
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A heritage textile product (Saree, Crochet, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "stock": { "type": "number" },
        "sareeImg": { "type": "string" },
        "modelImg": { "type": "string" },
        "variety": { "type": "string" },
        "category": { "type": "string", "enum": ["saree", "crochet", "lehenga"] },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" }
      }
    },
    "RestockRequest": {
      "title": "RestockRequest",
      "description": "A customer interest request for an out-of-stock product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "notified"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/SareeCollection/{sareeId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Main product catalog."
    },
    "/restockRequests/{requestId}": {
      "schema": { "$ref": "#/backend/entities/RestockRequest" },
      "description": "Waitlist for out-of-stock items."
    }
  }
}
