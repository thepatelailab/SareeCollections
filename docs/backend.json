
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A heritage product (Saree, Crochet, etc.)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "ownerId": { "type": "string" },
        "category": { "type": "string" },
        "isArchived": { "type": "boolean" }
      }
    },
    "RestockRequest": {
      "title": "Restock Request",
      "description": "A request from a user to be notified when a product is back in stock.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "notified"] }
      }
    }
  },
  "auth": {
    "providers": ["email", "anonymous"]
  },
  "firestore": {
    "/SareeCollection/{id}": {
      "schema": "#/entities/Product",
      "description": "Main product collection"
    },
    "/restockRequests/{id}": {
      "schema": "#/entities/RestockRequest",
      "description": "User requests for back-in-stock notifications"
    },
    "/orders/{id}": {
      "schema": "object",
      "description": "Order records"
    },
    "/users/{id}": {
      "schema": "object",
      "description": "User profiles"
    }
  }
}
